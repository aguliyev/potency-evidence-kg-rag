#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

if ! command -v docker >/dev/null 2>&1; then
    echo "Docker is required. Install Docker Desktop or Docker Engine with the Compose plugin." >&2
    exit 1
fi

if ! docker compose version >/dev/null 2>&1; then
    echo "Docker Compose plugin is required. Install the Compose plugin for Docker." >&2
    exit 1
fi

mkdir -p etc/secrets
if [[ ! -f etc/secrets/.env ]]; then
    cp etc/secrets/.env.example etc/secrets/.env
    echo "Created etc/secrets/.env from its example. Edit it with your local credentials."
fi

docker compose -f docker/compose.yaml --env-file etc/.env --env-file etc/secrets/.env build
