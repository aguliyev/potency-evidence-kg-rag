# Shared local configuration passed to every Compose container.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_USER=notebook
POSTGRES_DB=notebook
JUPYTER_HOST_PORT=8888
# Generation LLM: any OpenAI-compatible endpoint. LLM_API_KEY (etc/secrets/.env) must match it.
LLM_URI=https://api.anthropic.com/v1
LLM_MODEL=claude-opus-5-5
# LLM_URI=https://api.meta.ai/v1
# LLM_MODEL=muse-spark-1.3-contributor
EMBEDDING_LLM_URI=https://api.openai.com/v1
EMBEDDING_LLM_MODEL=text-embedding-3-large
KG_RUN_REAL_MODELS=true
